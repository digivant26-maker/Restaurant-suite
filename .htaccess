# Apache rules (Hostinger)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS on every real domain (local development on localhost stays on http).
  # To force www as well, use Hostinger's redirect settings or add a rule for your own domain here.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Block private folders and files
  RewriteRule ^(app|db|storage|vendor|tests|deploy)(/|$) - [F,L]
  RewriteRule ^(config|config\.example)\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(sql|md|log|lock)$ - [F,L]

  # Everything that is not a real file goes to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  <FilesMatch "\.(woff2|png|jpg|svg|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
